<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Notificaciones (Android 13+) y su promoción a Live Update (Android 16+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

    <application>
        <receiver
            android:name="com.vmichael1999.live_island.LiveActionReceiver"
            android:exported="false" />
        <!-- Cuadro de texto de los botones de respuesta en línea. -->
        <activity
            android:name="com.vmichael1999.live_island.LiveReplyActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>
</manifest>
