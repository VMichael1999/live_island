{
  "v": 1,
  "theme": { "accent": "#1B5E20", "background": "system" },
  "appLogo": { "t": "icon", "sf": "trophy.fill", "android": "assets/live/trophy.png" },
  "regions": {
    "compactLeading": { "t": "icon", "sf": "trophy.fill", "android": "assets/live/trophy.png", "accent": true },
    "compactTrailing": { "t": "text", "bind": "destacado", "size": 15, "w": 600, "accent": true },
    "minimal": { "t": "icon", "sf": "trophy.fill", "android": "assets/live/trophy.png", "accent": true },
    "expanded": {
      "leading": { "t": "box", "size": 46, "radius": 14, "tint": 0.22, "child": { "t": "icon", "sf": "trophy.fill", "android": "assets/live/trophy.png", "size": 24, "accent": true } },
      "center": {
        "t": "col",
        "c": [
          { "t": "text", "bind": "titulo", "size": 15, "w": 600, "lines": 2 },
          { "t": "text", "bind": "subtitulo", "size": 13, "muted": true }
        ]
      },
      "trailing": {
        "t": "col",
        "align": "end",
        "c": [
          { "t": "text", "bind": "destacado", "size": 22, "w": 700, "accent": true },
          { "t": "text", "bind": "nombre", "size": 12, "muted": true }
        ]
      }
    },
    "lockScreen": { "same": "expanded" }
  },
  "android": {
    "title": { "bind": "titulo" },
    "text": { "fmt": "{subtitulo} · {nombre}" },
    "chip": { "t": "text", "text": "2–1" },
    "colorized": false
  }
}
