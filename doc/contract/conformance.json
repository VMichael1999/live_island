{
  "descripcion": "Casos que Dart, Swift y Kotlin deben resolver igual. Cada plataforma tiene una prueba que lee este archivo (test/conformidad_test.dart, LiveConformanceTest.kt y tool/conformidad_swift.sh). Las reglas están en doc/contract/README.md.",
  "format": [
    { "nombre": "texto y un campo", "fmt": "Hola {nombre}", "state": { "nombre": "Ana" }, "expect": "Hola Ana" },
    { "nombre": "dos campos", "fmt": "{a} · {b}", "state": { "a": "x", "b": "y" }, "expect": "x · y" },
    { "nombre": "campos pegados", "fmt": "{a}{b}", "state": { "a": "0", "b": "2" }, "expect": "02" },
    { "nombre": "entero", "fmt": "{n} min", "state": { "n": 5 }, "expect": "5 min" },
    { "nombre": "entero escrito como decimal", "fmt": "{n}", "state": { "n": 5.0 }, "expect": "5" },
    { "nombre": "decimal", "fmt": "{n}", "state": { "n": 2.5 }, "expect": "2.5" },
    { "nombre": "decimal menor que uno", "fmt": "{n}", "state": { "n": 0.34 }, "expect": "0.34" },
    { "nombre": "decimal negativo", "fmt": "{n}", "state": { "n": -3.5 }, "expect": "-3.5" },
    { "nombre": "entero negativo", "fmt": "{n}", "state": { "n": -3 }, "expect": "-3" },
    { "nombre": "entero grande", "fmt": "{n}", "state": { "n": 1000000 }, "expect": "1000000" },
    { "nombre": "cero", "fmt": "{n}", "state": { "n": 0 }, "expect": "0" },
    { "nombre": "booleano verdadero", "fmt": "{b}", "state": { "b": true }, "expect": "true" },
    { "nombre": "booleano falso", "fmt": "{b}", "state": { "b": false }, "expect": "false" },
    { "nombre": "campo que falta", "fmt": "[{falta}]", "state": {}, "expect": "[]" },
    { "nombre": "campo nulo", "fmt": "[{x}]", "state": { "x": null }, "expect": "[]" },
    { "nombre": "con espacios no es un campo", "fmt": "{ x }", "state": { "x": "1" }, "expect": "{ x }" },
    { "nombre": "llaves vacías", "fmt": "{}", "state": {}, "expect": "{}" },
    { "nombre": "llave sin cerrar", "fmt": "{a", "state": { "a": "x" }, "expect": "{a" },
    { "nombre": "sin llaves", "fmt": "sin campos", "state": { "a": "x" }, "expect": "sin campos" },
    { "nombre": "moneda con acento", "fmt": "S/ {t} · Llegarás", "state": { "t": "18.50" }, "expect": "S/ 18.50 · Llegarás" },
    { "nombre": "campo con guion bajo y número", "fmt": "{pin_1}", "state": { "pin_1": "7" }, "expect": "7" }
  ],
  "condition": [
    { "nombre": "eq texto igual", "cond": { "bind": "e", "eq": "a" }, "state": { "e": "a" }, "expect": true },
    { "nombre": "eq texto distinto", "cond": { "bind": "e", "eq": "a" }, "state": { "e": "b" }, "expect": false },
    { "nombre": "eq número igual", "cond": { "bind": "n", "eq": 2 }, "state": { "n": 2 }, "expect": true },
    { "nombre": "eq entero contra decimal", "cond": { "bind": "n", "eq": 2 }, "state": { "n": 2.0 }, "expect": true },
    { "nombre": "eq número contra texto numérico", "cond": { "bind": "n", "eq": 5 }, "state": { "n": "5" }, "expect": true },
    { "nombre": "eq texto contra número", "cond": { "bind": "n", "eq": "5" }, "state": { "n": 5 }, "expect": true },
    { "nombre": "eq booleano", "cond": { "bind": "b", "eq": true }, "state": { "b": true }, "expect": true },
    { "nombre": "eq booleano contra uno", "cond": { "bind": "b", "eq": true }, "state": { "b": 1 }, "expect": false },
    { "nombre": "eq campo que falta", "cond": { "bind": "z", "eq": "a" }, "state": {}, "expect": false },
    { "nombre": "neq distinto", "cond": { "bind": "e", "neq": "a" }, "state": { "e": "b" }, "expect": true },
    { "nombre": "neq igual", "cond": { "bind": "e", "neq": "a" }, "state": { "e": "a" }, "expect": false },
    { "nombre": "gt mayor", "cond": { "bind": "n", "gt": 3 }, "state": { "n": 4 }, "expect": true },
    { "nombre": "gt igual", "cond": { "bind": "n", "gt": 3 }, "state": { "n": 3 }, "expect": false },
    { "nombre": "gte igual", "cond": { "bind": "n", "gte": 3 }, "state": { "n": 3 }, "expect": true },
    { "nombre": "lt menor", "cond": { "bind": "n", "lt": 3 }, "state": { "n": 2.5 }, "expect": true },
    { "nombre": "lte igual", "cond": { "bind": "n", "lte": 3 }, "state": { "n": 3 }, "expect": true },
    { "nombre": "gt campo que falta", "cond": { "bind": "z", "gt": 0 }, "state": {}, "expect": false },
    { "nombre": "gt texto no numérico", "cond": { "bind": "t", "gt": 0 }, "state": { "t": "hola" }, "expect": false },
    { "nombre": "gt con booleano no es número", "cond": { "bind": "b", "gt": 0 }, "state": { "b": true }, "expect": false },
    { "nombre": "lte con booleano no es número", "cond": { "bind": "b", "lte": 5 }, "state": { "b": false }, "expect": false },
    { "nombre": "gt texto numérico", "cond": { "bind": "t", "gt": 3 }, "state": { "t": "5" }, "expect": true },
    { "nombre": "truthy con texto", "cond": { "bind": "t", "truthy": true }, "state": { "t": "algo" }, "expect": true },
    { "nombre": "truthy con texto vacío", "cond": { "bind": "t", "truthy": true }, "state": { "t": "" }, "expect": false },
    { "nombre": "truthy con cero", "cond": { "bind": "n", "truthy": true }, "state": { "n": 0 }, "expect": false },
    { "nombre": "truthy con número", "cond": { "bind": "n", "truthy": true }, "state": { "n": 3 }, "expect": true },
    { "nombre": "truthy con falso", "cond": { "bind": "b", "truthy": true }, "state": { "b": false }, "expect": false },
    { "nombre": "truthy con nulo", "cond": { "bind": "b", "truthy": true }, "state": { "b": null }, "expect": false },
    { "nombre": "truthy con campo que falta", "cond": { "bind": "z", "truthy": true }, "state": {}, "expect": false },
    { "nombre": "truthy con el texto false", "cond": { "bind": "t", "truthy": true }, "state": { "t": "false" }, "expect": true },
    { "nombre": "truthy false invierte (vacío)", "cond": { "bind": "t", "truthy": false }, "state": { "t": "" }, "expect": true },
    { "nombre": "truthy false invierte (con valor)", "cond": { "bind": "t", "truthy": false }, "state": { "t": "algo" }, "expect": false }
  ],
  "countdown": [
    { "segundos": 0, "expect": "0:00" },
    { "segundos": 5, "expect": "0:05" },
    { "segundos": 65, "expect": "1:05" },
    { "segundos": 599, "expect": "9:59" },
    { "segundos": 3600, "expect": "1:00:00" },
    { "segundos": 3725, "expect": "1:02:05" }
  ]
}
